<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@chars@</string>
		<key>chars</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld znaki</string>
			<key>many</key>
			<string>%lld znaków</string>
			<key>one</key>
			<string>%lld znak</string>
			<key>other</key>
			<string>%lld znaku</string>
		</dict>
	</dict>
	<key>%lld pinned</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@pinned@</string>
		<key>pinned</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld przypięte</string>
			<key>many</key>
			<string>%lld przypiętych</string>
			<key>one</key>
			<string>%lld przypięty</string>
			<key>other</key>
			<string>%lld przypiętego</string>
		</dict>
	</dict>
	<key>%lld scans</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld skany</string>
			<key>many</key>
			<string>%lld skanów</string>
			<key>one</key>
			<string>%lld skan</string>
			<key>other</key>
			<string>%lld skanu</string>
		</dict>
	</dict>
	<key>Clear %lld scans?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Wyczyścić %lld skany?</string>
			<key>many</key>
			<string>Wyczyścić %lld skanów?</string>
			<key>one</key>
			<string>Wyczyścić %lld skan?</string>
			<key>other</key>
			<string>Wyczyścić %lld skanu?</string>
		</dict>
	</dict>
	<key>Cleared %lld scans</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Wyczyszczono %lld skany</string>
			<key>many</key>
			<string>Wyczyszczono %lld skanów</string>
			<key>one</key>
			<string>Wyczyszczono %lld skan</string>
			<key>other</key>
			<string>Wyczyszczono %lld skanu</string>
		</dict>
	</dict>
	<key>Download %lld languages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@langs@</string>
		<key>langs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Pobierz %lld języki</string>
			<key>many</key>
			<string>Pobierz %lld języków</string>
			<key>one</key>
			<string>Pobierz %lld język</string>
			<key>other</key>
			<string>Pobierz %lld języka</string>
		</dict>
	</dict>
</dict>
</plist>
