<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@chars@</string>
		<key>chars</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Zeichen</string>
			<key>other</key>
			<string>%lld Zeichen</string>
		</dict>
	</dict>
	<key>%lld pinned</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@pinned@</string>
		<key>pinned</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld angeheftet</string>
			<key>other</key>
			<string>%lld angeheftet</string>
		</dict>
	</dict>
	<key>%lld scans</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Scan</string>
			<key>other</key>
			<string>%lld Scans</string>
		</dict>
	</dict>
	<key>Clear %lld scans?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Scan löschen?</string>
			<key>other</key>
			<string>%lld Scans löschen?</string>
		</dict>
	</dict>
	<key>Cleared %lld scans</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Scan gelöscht</string>
			<key>other</key>
			<string>%lld Scans gelöscht</string>
		</dict>
	</dict>
	<key>Download %lld languages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@langs@</string>
		<key>langs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Sprache laden</string>
			<key>other</key>
			<string>%lld Sprachen laden</string>
		</dict>
	</dict>
</dict>
</plist>
