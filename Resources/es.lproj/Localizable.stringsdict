<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@chars@</string>
		<key>chars</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld carácter</string>
			<key>other</key>
			<string>%lld caracteres</string>
		</dict>
	</dict>
	<key>%lld pinned</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@pinned@</string>
		<key>pinned</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld fijado</string>
			<key>other</key>
			<string>%lld fijados</string>
		</dict>
	</dict>
	<key>%lld scans</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld escaneo</string>
			<key>other</key>
			<string>%lld escaneos</string>
		</dict>
	</dict>
	<key>Clear %lld scans?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>¿Borrar %lld escaneo?</string>
			<key>other</key>
			<string>¿Borrar %lld escaneos?</string>
		</dict>
	</dict>
	<key>Cleared %lld scans</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scans@</string>
		<key>scans</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld escaneo borrado</string>
			<key>other</key>
			<string>%lld escaneos borrados</string>
		</dict>
	</dict>
	<key>Download %lld languages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@langs@</string>
		<key>langs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Descargar %lld idioma</string>
			<key>other</key>
			<string>Descargar %lld idiomas</string>
		</dict>
	</dict>
</dict>
</plist>
